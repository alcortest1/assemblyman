livekit.txt

# Agent credentials — never commit
.env.local
agent/.env.local
agent/.venv/
__pycache__/
*.pyc

# Optional local LiveKit SDK checkout. The Xcode project uses a pinned remote revision.
client-sdk-swift/

# iOS relay credentials — never commit. The committed LiveKit.xcconfig carries
# empty defaults and optionally includes this file.
LiveKit.local.xcconfig
.vercel
.env*

# Local worktrees and captured session data — not source.
.claude/
dataset/

# Xcode derived data written into the sample by `xcodebuild -derivedDataPath build/…`.
# Untracked it is 1.3 GB and 7,000-odd files, one `git add .` away from the history.
samples/*/build/
portal/data/frames/
portal/data/thumbs/
