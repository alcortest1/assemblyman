# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. 1 = let Gemini volunteer observations; 0 (default) = speak only when asked.
ASSEMBLYMAN_PROACTIVE=0

# Optional. Override the realtime model.
ASSEMBLYMAN_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
