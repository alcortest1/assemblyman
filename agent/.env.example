# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional. 1 = let Gemini volunteer observations; 0 (default) = speak only when asked.
ASSEMBLYMAN_PROACTIVE=0

# Optional. Override the realtime model. Must be a *live* model — the pro models
# are not realtime and cannot drive a session. AI Studio serves the 3.1 live
# model; Vertex does not, so a service account will not work here.
ASSEMBLYMAN_MODEL=gemini-3.1-flash-live-preview

# --------------------------------------------------------------- grading
#
# The agent grades the operator's work on request against the rubrics in
# alcor_agents/criteria/. That directory is generated, not source: without it the
# agent runs exactly as before, minus the grading tool.

# Optional. Vision model that grades a captured still. NOT the realtime model:
# the live model hosts the conversation and calls this one with the photograph.
# A flash model is a few seconds quicker and noticeably worse at reading a scribed
# line on bare metal, which is the whole job.
ASSEMBLYMAN_GRADER_MODEL=gemini-3.1-pro-preview

# Optional. Seconds to wait for the glasses to take a photo and the phone to send
# it. When it lapses the agent grades the relayed video frame instead, and the
# result says which image it used.
# ASSEMBLYMAN_CAPTURE_TIMEOUT=20

# Optional. Seconds before a grade gives up and reports a timeout.
# ASSEMBLYMAN_GRADE_TIMEOUT=45

# Optional. Where the rubrics live, if not ../alcor_agents/criteria.
# ASSEMBLYMAN_CRITERIA_DIR=

# Optional. 0 drops the "Source basis" provenance from each rubric — 27% of the
# prompt. Costs the agent the ability to cite the handbook page it graded from.
# ASSEMBLYMAN_CRITERIA_SOURCES=1
